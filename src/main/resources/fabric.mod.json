{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft",
    "description": "Renders Minecraft through NVIDIA RTX Remix path tracing. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA"
    ],
    "contact": {
        "homepage": "https://github.com/kazumasa200/rtx-remix-minecraft-26-3",
        "sources": "https://github.com/kazumasa200/rtx-remix-minecraft-26-3",
        "issues": "https://github.com/kazumasa200/rtx-remix-minecraft-26-3/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json",
        "rtx-remix-renderer.distanthorizons.mixins.json",
        "rtx-remix-renderer.sodium.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.19.5",
        "fabric-api": ">=0.165.0+26.3",
        "minecraft": "26.3",
        "java": ">=25"
    },
    "breaks": {
        "sodium": [
            "<0.9.2",
            ">0.9.2"
        ]
    }
}
